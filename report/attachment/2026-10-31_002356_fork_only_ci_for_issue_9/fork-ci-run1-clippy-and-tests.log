2026-10-30T15:24:07.0513754Z changed="$RUNNER_TEMP/changed-files.txt"
2026-10-30T15:24:07.0514033Z if [[ "$EVENT_NAME" == pull_request ]]; then
2026-10-30T15:24:07.0514330Z   git diff --name-only "$BASE_SHA"...HEAD > "$changed"
2026-10-30T15:24:07.0514730Z elif [[ -z "$BEFORE_SHA" || "$BEFORE_SHA" =~ ^0+$ ]] || ! git cat-file -e "$BEFORE_SHA^{commit}"; then
2026-10-30T15:24:07.0515158Z   # No usable previous commit: select the whole workspace.
2026-10-30T15:24:07.0515439Z   echo Cargo.lock > "$changed"
2026-10-30T15:24:07.0515652Z else
2026-10-30T15:24:07.0515874Z   git diff --name-only "$BEFORE_SHA"..HEAD > "$changed"
2026-10-30T15:24:07.0516344Z fi
2026-10-30T15:24:07.0516561Z cat "$changed"
2026-10-30T15:24:07.0516745Z 
2026-10-30T15:24:07.0517000Z selection=$(bash scripts/affected-crates.sh --stdin < "$changed")
2026-10-30T15:24:07.0517301Z echo "$selection"
2026-10-30T15:24:07.0517546Z if [[ $(jq -r '.all_rust' <<<"$selection") == true ]]; then
2026-10-30T15:24:07.0518152Z   mapfile -t crates < <(jq -r '.affected[]' <<<"$selection")
2026-10-30T15:24:07.0518520Z else
2026-10-30T15:24:07.0529748Z   mapfile -t crates < <(jq -r '.test_crates[]' <<<"$selection")
2026-10-30T15:24:07.0530063Z fi
2026-10-30T15:24:07.0530311Z # A change to this workflow exercises both selection paths on
2026-10-30T15:24:07.0530664Z # one crate that builds on CPU alone and one that needs native.
2026-10-30T15:24:07.0531026Z if grep -Fqx .github/workflows/fork-ci.yml "$changed"; then
2026-10-30T15:24:07.0531361Z   crates+=(skippy-hf-hub mesh-llm-host-runtime)
2026-10-30T15:24:07.0531614Z fi
2026-10-30T15:24:07.0531776Z 
2026-10-30T15:24:07.0531936Z selected=()
2026-10-30T15:24:07.0532124Z skipped=()
2026-10-30T15:24:07.0532373Z for crate in $(printf '%s\n' "${crates[@]}" | sort -u); do
2026-10-30T15:24:07.0532716Z   # Crates that link skippy-ffi need the patched llama.cpp ABI
2026-10-30T15:24:07.0533068Z   # archives, which only the upstream runner image provides.
2026-10-30T15:24:07.0533464Z   if cargo tree --locked -p "$crate" -e normal,build,dev --prefix none --format '{p}' \
2026-10-30T15:24:07.0533883Z     | awk '{print $1}' | grep -Fqx skippy-ffi; then
2026-10-30T15:24:07.0534149Z     skipped+=("$crate")
2026-10-30T15:24:07.0534352Z   else
2026-10-30T15:24:07.0534530Z     selected+=("$crate")
2026-10-30T15:24:07.0534730Z   fi
2026-10-30T15:24:07.0534896Z done
2026-10-30T15:24:07.0535067Z 
2026-10-30T15:24:07.0535224Z {
2026-10-30T15:24:07.0535390Z   echo "### Rust crates"
2026-10-30T15:24:07.0535623Z   if [[ ${#selected[@]} -eq 0 ]]; then
2026-10-30T15:24:07.0535876Z     echo "No Rust crates affected."
2026-10-30T15:24:07.0536101Z   else
2026-10-30T15:24:07.0536487Z     printf -- '- `%s`\n' "${selected[@]}"
2026-10-30T15:24:07.0536718Z   fi
2026-10-30T15:24:07.0536907Z   if [[ ${#skipped[@]} -gt 0 ]]; then
2026-10-30T15:24:07.0537125Z     echo
2026-10-30T15:24:07.0537504Z     echo "### Skipped (needs native llama ABI)"
2026-10-30T15:24:07.0537767Z     printf -- '- `%s`\n' "${skipped[@]}"
2026-10-30T15:24:07.0538002Z   fi
2026-10-30T15:24:07.0538179Z } >> "$GITHUB_STEP_SUMMARY"
2026-10-30T15:24:07.0538429Z echo "crates=${selected[*]}" >> "$GITHUB_OUTPUT"
