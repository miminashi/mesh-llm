2026-10-30T15:35:48.9547657Z set -euo pipefail
2026-10-30T15:35:48.9547861Z # Hosted runners have no sccache, which .cargo/config.toml selects.
2026-10-30T15:35:48.9548128Z export RUSTC_WRAPPER='' CARGO_BUILD_RUSTC_WRAPPER=''
2026-10-30T15:35:48.9548348Z changed="$RUNNER_TEMP/changed-files.txt"
2026-10-30T15:35:48.9548545Z if [[ "$EVENT_NAME" == pull_request ]]; then
2026-10-30T15:35:48.9548759Z   git diff --name-only "$BASE_SHA"...HEAD > "$changed"
2026-10-30T15:35:48.9549046Z elif [[ -z "$BEFORE_SHA" || "$BEFORE_SHA" =~ ^0+$ ]] || ! git cat-file -e "$BEFORE_SHA^{commit}"; then
2026-10-30T15:35:48.9549359Z   # No usable previous commit: select the whole workspace.
2026-10-30T15:35:48.9549565Z   echo Cargo.lock > "$changed"
2026-10-30T15:35:48.9549718Z else
2026-10-30T15:35:48.9549883Z   git diff --name-only "$BEFORE_SHA"..HEAD > "$changed"
2026-10-30T15:35:48.9550104Z fi
2026-10-30T15:35:48.9550223Z cat "$changed"
2026-10-30T15:35:48.9550353Z 
2026-10-30T15:35:48.9550758Z selection=$(bash scripts/affected-crates.sh --stdin < "$changed")
2026-10-30T15:35:48.9550977Z echo "$selection"
2026-10-30T15:35:48.9551155Z if [[ $(jq -r '.all_rust' <<<"$selection") == true ]]; then
2026-10-30T15:35:48.9551389Z   mapfile -t crates < <(jq -r '.affected[]' <<<"$selection")
2026-10-30T15:35:48.9551581Z else
2026-10-30T15:35:48.9551744Z   mapfile -t crates < <(jq -r '.test_crates[]' <<<"$selection")
2026-10-30T15:35:48.9551942Z fi
2026-10-30T15:35:48.9552107Z # A change to this workflow exercises both selection paths on
2026-10-30T15:35:48.9552358Z # one crate that builds on CPU alone and one that needs native.
2026-10-30T15:35:48.9552607Z if grep -Fqx .github/workflows/fork-ci.yml "$changed"; then
2026-10-30T15:35:48.9552827Z   crates+=(skippy-hf-hub skippy-runtime)
2026-10-30T15:35:48.9553000Z fi
2026-10-30T15:35:48.9553109Z 
2026-10-30T15:35:48.9553222Z selected=()
2026-10-30T15:35:48.9553349Z skipped=()
2026-10-30T15:35:48.9553522Z for crate in $(printf '%s\n' "${crates[@]}" | sort -u); do
2026-10-30T15:35:48.9553767Z   # skippy-ffi without its dynamic-runtime feature links the
2026-10-30T15:35:48.9554023Z   # patched llama.cpp ABI archives, which only the upstream runner
2026-10-30T15:35:48.9554236Z   # image provides.
2026-10-30T15:35:48.9554493Z   tree=$(cargo tree --locked -p "$crate" -e normal,build,dev --prefix none --format '{p} [{f}]')
2026-10-30T15:35:48.9554772Z   ffi=$(awk '$1 == "skippy-ffi"' <<<"$tree")
2026-10-30T15:35:48.9554977Z   if [[ -n "$ffi" && "$ffi" != *dynamic-runtime* ]]; then
2026-10-30T15:35:48.9555167Z     skipped+=("$crate")
2026-10-30T15:35:48.9555312Z   else
2026-10-30T15:35:48.9555442Z     selected+=("$crate")
2026-10-30T15:35:48.9555583Z   fi
2026-10-30T15:35:48.9555694Z done
2026-10-30T15:35:48.9555806Z 
2026-10-30T15:35:48.9555911Z {
2026-10-30T15:35:48.9556031Z   echo "### Rust crates"
2026-10-30T15:35:48.9556190Z   if [[ ${#selected[@]} -eq 0 ]]; then
2026-10-30T15:35:48.9556373Z     echo "No Rust crates affected."
2026-10-30T15:35:48.9556528Z   else
2026-10-30T15:35:48.9556666Z     printf -- '- `%s`\n' "${selected[@]}"
2026-10-30T15:35:48.9556972Z   fi
2026-10-30T15:35:48.9557103Z   if [[ ${#skipped[@]} -gt 0 ]]; then
2026-10-30T15:35:48.9557262Z     echo
2026-10-30T15:35:48.9557409Z     echo "### Skipped (needs native llama ABI)"
2026-10-30T15:35:48.9557601Z     printf -- '- `%s`\n' "${skipped[@]}"
2026-10-30T15:35:48.9557764Z   fi
2026-10-30T15:35:48.9557890Z } >> "$GITHUB_STEP_SUMMARY"
2026-10-30T15:35:48.9558219Z echo "crates=${selected[*]}" >> "$GITHUB_OUTPUT"
